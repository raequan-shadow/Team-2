@startuml
title SmartPark - Prisma PostgreSQL Data Model
hide methods
skinparam classAttributeIconSize 0
skinparam linetype ortho

enum SpaceStatus {
  AVAILABLE
  OCCUPIED
  UNKNOWN
  OUT_OF_SERVICE
}

enum SensorStatus {
  ONLINE
  STALE
  OFFLINE
  UNKNOWN
}

class ParkingDeck {
  +id: String [UUID] <<PK>>
  +code: String <<UNIQUE>>
  +name: String
  +locationLabel: String
  +totalCapacity: Int
  +latitude: Decimal? [9,6]
  +longitude: Decimal? [9,6]
  +isActive: Boolean = true
}

class ParkingFloor {
  +id: String [UUID] <<PK>>
  +deckId: String [UUID] <<FK>>
  +floorNumber: Int
  +label: String?
  --
  UNIQUE (deckId, floorNumber)
}

class ParkingSpace {
  +id: String [UUID] <<PK>>
  +floorId: String [UUID] <<FK>>
  +code: String
  +section: String?
  +status: SpaceStatus = UNKNOWN
  +statusUpdatedAt: DateTime? [Timestamptz(3)]
  --
  UNIQUE (floorId, code)
  INDEX (status)
}

class Sensor {
  +id: String [UUID] <<PK>>
  +code: String <<UNIQUE>>
  +deckId: String [UUID] <<FK>>
  +type: String
  +status: SensorStatus = UNKNOWN
  +lastSeenAt: DateTime? [Timestamptz(3)]
  --
  UNIQUE (id, deckId)
}

class OccupancyReading {
  +id: String [UUID] <<PK>>
  +deckId: String [UUID] <<FK>>
  +sensorId: String? [UUID, FK]
  +occupiedCount: Int?
  +observedAt: DateTime [Timestamptz(3)]
  +receivedAt: DateTime [Timestamptz(3)] = now()
  --
  INDEX (deckId, observedAt DESC)
  INDEX (sensorId, observedAt DESC)
}

class CampusBuilding {
  +id: String [UUID] <<PK>>
  +code: String <<UNIQUE>>
  +name: String
  +latitude: Decimal [9,6]
  +longitude: Decimal [9,6]
  +isActive: Boolean = true
}

ParkingDeck "1" -- "0..*" ParkingFloor : contains
ParkingFloor "1" -- "0..*" ParkingSpace : contains
ParkingDeck "1" -- "0..*" Sensor : monitors
ParkingDeck "1" -- "0..*" OccupancyReading : records
Sensor "0..1" -- "0..*" OccupancyReading : source for

note right of OccupancyReading
  sensorId is nullable. When present,
  the composite FK (sensorId, deckId)
  requires the sensor to belong to
  the same deck as the reading.
  NULL occupiedCount means unavailable,
  not zero occupancy.
end note

note bottom of CampusBuilding
  No Prisma relation or FK connects
  buildings to decks; nearby results
  are computed from their coordinates.
end note

note bottom
  UUID, defaults, mapped database column names, and unique/index constraints
  follow v2/prisma/schema.prisma. PostgreSQL CHECK constraints and the
  capacity trigger are defined in the initial migration SQL, not as models.
end note
@enduml
